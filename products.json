{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "array",
    "uniqueItems": true,
    "items": {
        "type": "object",
        "properties": {
            "name": {
                "type": "string"
            },
            "id": {
                "type": "integer"
            },
            "price": {
                "type": "number"
            }
        },
        "required": [
            "name",
            "id",
            "price"
        ]
    }
}
